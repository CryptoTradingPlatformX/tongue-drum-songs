{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "song.schema.json",
  "title": "Tongue drum song",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "artist",
    "source",
    "license",
    "attribution",
    "difficulty",
    "tempo",
    "timeSignature",
    "arrangements",
    "verified"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "kebab-case id, unique, matches the filename"
    },
    "title": { "type": "string", "minLength": 1 },
    "artist": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      }
    },
    "license": {
      "enum": ["public-domain", "CC0", "CC-BY-4.0", "CC-BY-SA-4.0", "other-permissive"]
    },
    "attribution": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "tempo": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 400,
      "description": "Quarter-note BPM in every meter, including 6/4, 6/8, 9/8, 12/8, 2/2, 3/2, and 4/2"
    },
    "timeSignature": {
      "description": "dur is always in quarter-note beats. 4/4 is 4 quarter-beats, 3/4 is 3, 2/4 is 2. A 2/2 bar is 4 quarter-beats grouped as two half-note pulses. A 3/2 bar is 6 quarter-beats grouped as three half-note pulses. A 4/2 bar is 8 quarter-beats grouped as four half-note pulses. A 6/4 bar is 6 quarter-beats grouped as two dotted-half pulses. A 6/8 bar is 3 quarter-beats grouped as two dotted-quarter pulses. A 9/8 bar is 4.5 quarter-beats grouped as three dotted-quarter pulses. A 12/8 bar is 6 quarter-beats grouped as four dotted-quarter pulses.",
      "enum": ["4/4", "3/4", "2/4", "2/2", "3/2", "4/2", "6/4", "6/8", "9/8", "12/8"]
    },
    "arrangements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C", "D"],
      "properties": {
        "C": { "$ref": "#/$defs/arrangement" },
        "D": { "$ref": "#/$defs/arrangement" }
      }
    },
    "form": {
      "type": "array",
      "minItems": 1,
      "description": "Optional play order. Each entry repeats a section. verse selects lyrics when that section is listed in verses.",
      "items": { "$ref": "#/$defs/formEntry" }
    },
    "verses": {
      "type": "object",
      "description": "Optional lyrics by section. verses[section][n-1] is verse n, one string per line of that section. An empty string means no lyric.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "verseLines": {
      "type": "object",
      "description": "Optional per-verse note variants. verseLines[section][verseNumber][lineIndex] is { C, D }. Verse numbers and line indexes are strings. Each line has notes and an optional lyric; section is omitted. A variant replaces that line when form plays that section and verse.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[1-9][0-9]*$" },
        "additionalProperties": {
          "type": "object",
          "propertyNames": { "pattern": "^(?:0|[1-9][0-9]*)$" },
          "additionalProperties": { "$ref": "#/$defs/verseLinePair" }
        }
      }
    },
    "arrangerNotes": { "type": "string" },
    "verified": { "type": "boolean" }
  },
  "$defs": {
    "arrangement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minLayout", "lines"],
      "properties": {
        "minLayout": { "enum": ["8", "11", "13", "15"] },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/line" }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes"],
      "properties": {
        "lyric": { "type": "string" },
        "section": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Optional section slug. Required on every line when form is set."
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/note" }
        }
      }
    },
    "note": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rest", "dur"],
          "properties": {
            "rest": { "const": true },
            "dur": { "$ref": "#/$defs/dur" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["deg", "oct", "dur"],
          "properties": {
            "deg": { "type": "integer", "minimum": 1, "maximum": 7 },
            "oct": { "type": "integer", "minimum": -1, "maximum": 1 },
            "dur": { "$ref": "#/$defs/dur" }
          }
        }
      ]
    },
    "formEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section"],
      "properties": {
        "section": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "verse": { "type": "integer", "minimum": 1 }
      }
    },
    "variantLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes"],
      "description": "Same shape as an arrangement line, without section.",
      "properties": {
        "lyric": { "type": "string" },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/note" }
        }
      }
    },
    "verseLinePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C", "D"],
      "properties": {
        "C": { "$ref": "#/$defs/variantLine" },
        "D": { "$ref": "#/$defs/variantLine" }
      }
    },
    "dur": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Duration in quarter-note beats"
    }
  }
}
